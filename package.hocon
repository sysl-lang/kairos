// An event loop for a microcontroller, shaped like libuv and written for interrupts: numbered
// sources an interrupt raises, timers on one clock, and idle and check handles.
//
// This is the block a *consumer* writes to reach this package:
//
//     dependencies {
//       kairos { git = "github.com/sysl-lang/kairos", version = "0.1.0" }
//     }
//
// The module a program imports is `sh.sysl.kairos`; `sh.sysl.kairos.sim` is the simulated driver
// the tests run on, `sh.sysl.kairos.host` the real-time one for a laptop, and `sh.sysl.kairos.uv`
// the libuv one, with sockets and files, behind the `uv` feature:
//
//     kairos { git = "github.com/sysl-lang/kairos", version = "0.1.0", features = [uv] }

package {
  name    = "kairos"
  version = "0.1.0"
  sysl    = "0.0.162"
}

// **`heap`, because handlers and timers are closures, a task's frame is on the heap, and the tables
// holding them grow.** Everything on the heap is made while the program registers, schedules and
// spawns -- on the loop's side, never in an interrupt. `signal`, the one function an interrupt calls, touches a single atomic word of module
// storage and nothing else.
//
// **What is NOT here is `os` or `posix`.** The core reads no clock of its own: a `Driver` supplies
// time and sleep. `sh.sysl.kairos.host` is the one module that asks the operating system for either,
// and it carries `@requires(posix)` on itself, so a board that never imports it never asks.
requires {
  heap = true
}

// **`uv` is the one feature, and it is off unless a consumer asks for it**: it brings the libuv
// driver, `sh.sysl.kairos.uv` -- `uv()`, TCP, whole files and name lookups -- and with it the
// `libuv` package, which needs libuv installed (`brew install libuv`, Debian's `libuv1-dev`). With
// it off, that module is empty and nothing of libuv is fetched, asked for or linked. It only adds.
features {
  uv = [libuv]
}

dependencies {
  libuv { git = "github.com/sysl-lang/libuv", version = "0.1.8", optional = true }
}
