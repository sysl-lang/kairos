module sh.sysl.kairos.host
@tests

import sysl.time.{millis, whole_micros}
import sysl.posix.time.{monotonic, sleep}
import sysl.threads.spawn
import sh.sysl.kairos.{Loop, Remote, Waker, event_loop}

private async two_naps(lp: &Loop[Host]) -> long
    await lp.sleep(millis(10))
    await lp.sleep(millis(15))
    whole_micros(lp.now()) / 1000

@test("on the host driver a task's sleeps take real time: two naps end no sooner than their sum")
host_sleeps_take_real_time()
    val lp = event_loop(host())
    val started = monotonic()

    val at = lp.block_on(two_naps(lp)).expect("nothing stops this loop")
    val took = whole_micros(monotonic() - started) / 1000

    assert(at >= 25)
    assert(took >= 25)
    assert(took < 1000)
end host_sleeps_take_real_time

private struct Fires
    n: int

@test("on the host driver a background five-second timer does not hold run, which returns at once")
host_background_timer_does_not_hold()
    val lp = event_loop(host())
    val f: &Fires = Fires(0)
    val t =lp.after(millis(5000), (l) -> f.n += 1)
    val started = monotonic()

    t.background()
    lp.run()

    val took = whole_micros(monotonic() - started) / 1000

    assert(took < 1000, s"run returned promptly: $took ms")
    assert_eq(f.n, 0)
end host_background_timer_does_not_hold

@test("on the host driver a background periodic timer fires on time while a kept sleep holds the loop")
host_background_fires_while_held()
    val lp = event_loop(host())
    val f: &Fires = Fires(0)
    val started = monotonic()

    lp.every(millis(10), (l) -> f.n += 1).background()
    lp.block_on(lp.sleep(millis(55))).expect("nothing stops this loop")

    val took = whole_micros(monotonic() - started) / 1000

    // 10 through 50, and 60 only where the wake at 55 came late enough to find it due as well.
    assert(f.n == 5 || f.n == 6, s"fired at each period: ${f.n}")
    assert(took >= 55 && took < 1000, s"held by the sleep alone: $took ms")
    assert(!lp.alive())
end host_background_fires_while_held

private struct Raiser
    r: Remote
    w: Waker

// On another thread: wait 30 ms, then raise the remote and wake the notifier.
private raise_later(s: *Raiser) -> unit
    sleep(millis(30))
    s.r.raise()
    s.w.wake()

@test("on the host driver a remote and a notifier woken from another thread end the loop's wait")
host_wakes_across_threads()
    val lp = event_loop(host())
    val n = lp.notifier()
    var s = Raiser(lp.remote(4).expect("in range"), n.waker())
    val started = monotonic()
    val t = spawn(&raise_later, &s).unwrap()

    // Five seconds each: only the wakes end them sooner.
    val got = lp.block_on(lp.timeout(millis(5000), lp.wait_for(4))).expect("ran")
    val woke = lp.block_on(lp.timeout(millis(5000), n.next())).expect("ran")
    val took = whole_micros(monotonic() - started) / 1000

    assert(t.join())
    assert(got.is_some(), "the source was raised")
    assert(woke.is_some(), "the notifier was woken")
    assert(took < 1000, s"noticed within slices, not at the deadline: $took ms")
end host_wakes_across_threads
