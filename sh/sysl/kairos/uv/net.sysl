module sh.sysl.kairos.uv
#if feature_uv
@requires(posix)

// TCP: a connection to read from and write to, and a listener to accept them from.
//
//     val l = io.listen(ip4("127.0.0.1", 0)?)?
//     val conn = (await l.accept())?
//     val got = (await conn.read())?          // empty at the end of the stream
//     (await conn.write(got))?
//
// **libuv pushes and a task pulls.** A stream is read by starting libuv's reading, taking the first
// chunk that arrives, and stopping again inside the callback -- so nothing arrives that no `read`
// asked for, and a `read` that is dropped leaves the bytes in the kernel for the next one. That is
// what lets `lp.timeout(d, conn.read())` give up on a read without losing what comes after.

import sh.sysl.libuv
import sh.sysl.libuv.{Handle, Stream}

/** A connected TCP socket. Reached through `&Connection`; `close` ends it. Its reading and writing
 * are `stream.sysl`'s, shared with `Pipe`.
 */
struct Connection
    private[uv] sock: &libuv.Tcp
    private reads: &Reader

    /** A task that ends with the next bytes the peer sent -- at most 64 KiB -- or with an empty
     * slice once the peer has closed its half. Dropping it before it ends consumes nothing.
     */
    read(self) -> Task[Result[[]u8, Error]] = read_stream(self.sock, self.reads)

    /** A task that ends when `bytes` have been handed to the kernel. The bytes are copied at the
     * start, so the caller's slice need not outlive it.
     */
    write(self, bytes: []const u8) -> Task[Result[unit, Error]] = write_stream(self.sock, bytes)

    /** A task that ends when this side's half of the stream is closed: every write queued before it
     * has gone, and the peer reads the end of the stream. Reading goes on -- the peer may still
     * answer, and `read` hands that over until the peer closes its own half.
     */
    shutdown(self) -> Task[Result[unit, Error]] = shutdown_stream(self.sock)

    /** Turn Nagle's algorithm off (`true`) or back on: with it off, a small write is sent at once
     * rather than held back to be joined with the next.
     */
    nodelay(self, on: bool) -> Result[unit, Error]
        val s = self.sock

        Ok(s.nodelay(on)?)

    /** The address of the other end. */
    peer(self) -> Result[libuv.Address, Error]
        val s = self.sock

        Ok(s.peername()?)

    /** Close the socket. A task still reading from it ends with `ECANCELED`. Closing again does
     * nothing, and a connection dropped without being closed is closed then.
     */
    close(self) = close_stream(self.sock, self.reads)
end Connection

// A connection nobody holds any more is one nobody can close, so its going is the close -- and a read
// still in flight on it ends with `ECANCELED`.
impl Drop for Connection
    drop(self) = close_stream(self.sock, self.reads)

// Every socket here closes through this, so closing twice -- or closing and then dropping -- is safe.
private close_tcp(s: &libuv.Tcp)
    if !s.is_closing() then s.close()

/** A listening socket. `accept` takes the next connection; `close` stops listening. */
struct Listener
    private[uv] sock: &libuv.Tcp
    private arrived: usize
    private closed: bool
    private waiter: Option[&Pending[unit]]

    /** A task that ends with the next connection. Dropping it leaves that connection queued for
     * the next `accept`.
     */
    accept(&self) -> Task[Result[&Connection, Error]] = accept_from(self)

    /** The port this listener holds, which is the one the kernel chose for a port of `0`. */
    port(self) -> Result[int, Error]
        val s = self.sock

        Ok(s.sockname()?.port())

    /** Stop listening. A task waiting in `accept` ends with `ECANCELED`. Closing again does nothing,
     * and a listener dropped without being closed is closed then.
     */
    close(*self)
        close_tcp(self.sock)

        self.closed = true

        self.waiter match
            Some(p) ->
                self.waiter = None
                p.finish(())
            None -> ()

    // libuv's connection callback: one more is waiting, and a task may be waiting for it.
    private ready(*self)
        self.arrived += 1

        self.waiter match
            Some(p) ->
                self.waiter = None
                p.finish(())
            None -> ()
end Listener

// The socket's connection callback holds the listener only weakly (`listen_on`), so the listener
// goes when its last name does, and closes its socket as it goes.
impl Drop for Listener
    drop(self) = close_tcp(self.sock)

private[uv] async connect_on(lp: &libuv.Loop, addr: libuv.Address) -> Result[&Connection, Error]
    val s = libuv.tcp(lp)?
    var connected = false
    defer if !connected then s.close()

    val p: &Pending[Result[unit, Error]] = pending()

    s.connect(addr, (r) -> p.finish(r))?

    val r = await settled(p)

    r?
    connected = true
    Ok(Connection(s, reader()))

private[uv] listen_on(lp: &libuv.Loop, addr: libuv.Address, backlog: int) -> Result[&Listener, Error]
    val s = libuv.tcp(lp)?

    s.bind(addr) match
        Err(e) ->
            s.close()
            return Err(e)
        Ok(_) -> ()

    listening(s, backlog)
end listen_on

/** A listener over a socket that is already bound -- one bound here, or one another process sent
 * over a channel. It is closed if it cannot listen.
 */
private[uv] listening(s: &libuv.Tcp, backlog: int) -> Result[&Listener, Error]
    var l: &Listener = Listener(s, 0, false, None)

    // Weak, or the socket -- which the loop holds until it is closed -- would hold the listener,
    // and a listener nobody closed would never go.
    val held: weak Listener = l

    s.listen(backlog, () -> held.get() match
        Some(it) -> it.ready()
        None -> ()) match
        Err(e) ->
            s.close()
            return Err(e)
        Ok(_) -> ()

    Ok(l)
end listening

/** A connection over a socket that is already connected: one another process sent over a channel. */
private[uv] connection_of(s: &libuv.Tcp) -> &Connection = Connection(s, reader())

private async accept_from(l: &Listener) -> Result[&Connection, Error]
    if l.arrived == 0
        val p: &Pending[unit] = pending()

        l.waiter = Some(p)
        defer l.waiter = None
        await settled(p)

    if l.closed then return Err(cancelled())

    l.arrived -= 1

    val s = l.sock

    Ok(Connection(s.accept()?, reader()))
end accept_from
#endif
