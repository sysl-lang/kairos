module sh.sysl.kairos.uv
#if feature_uv
@requires(posix)

// The libuv driver: a loop whose waits are libuv's, so sockets, files and name lookups wake tasks
// the way a timer or a source does.
//
//     val io = uv()
//     val lp = event_loop(io)
//
//     lp.spawn(serve(io, io.listen(addr)?))
//     lp.run()
//
// **Every operation here is a task** -- `io.connect(addr)`, `conn.read()`, `io.read_file(path)` --
// awaited in a task of the loop beside `lp.sleep` and `lp.timeout`. Its libuv callback answers into a
// `Pending` and calls the waker the task parked with, so the task is stepped on the next pass.
//
// This module exists only when the package's `uv` feature is on, which is what brings the `libuv`
// dependency; with it off, nothing here is compiled and nothing of libuv is linked.

import sh.sysl.libuv
import sysl.time.{Duration, millis}
import sysl.posix.time.{monotonic, sleep}
import sh.sysl.libuv.Handle
import sh.sysl.kairos.{Driver, signalled}

/** libuv's answer to an operation that failed; `e.name()` is its short name (`ECONNREFUSED`). */
type Error = libuv.Error

/** A driver over a libuv loop: the host's monotonic clock, and `idle_until` running libuv until the
 * deadline or the next event, whichever is first.
 *
 * `busy` is libuv's own answer to whether the loop is alive -- an open listener, a read or a request
 * in flight, a handle still closing -- so a task waiting on any of them keeps the kairos loop running,
 * and a task waiting on nothing libuv watches is cancelled when nothing else is left, as on any driver.
 *
 * **Another thread reaches the loop through `lp.notifier()` or `lp.remote(n)`**, whose wakes send a
 * `uv_async` of the driver's: libuv's wait ends at once, and a loop waiting on nothing else blocks in
 * the kernel until one comes, using no time. A source raised with the process-wide `signal` from
 * another thread is noticed only when libuv next returns: at the next event or deadline, or within a
 * millisecond when libuv has nothing to wait for and no notifier or remote was made.
 */
struct Uv
    private lp: &libuv.Loop
    private timer: &libuv.Timer
    private origin: Duration
    private notify: Option[&libuv.Async]
    private quiets: &Quiet

    /** The libuv loop every handle and request this driver's operations make is on. */
    on_loop(self) -> &libuv.Loop = self.lp

    /** A task that connects to `addr` and ends with the connection, or with why there is none --
     * `ECONNREFUSED` when nothing is listening.
     */
    connect(self, addr: libuv.Address) -> Task[Result[&Connection, Error]] = connect_on(self.lp, addr)

    /** Bind `addr` and start listening. A port of `0` lets the kernel choose; `port()` says which.
     *
     * Two options, named at the call: `reuse_port` lets several listeners hold one port and has the
     * kernel share connections across them (`SO_REUSEPORT` with load balancing) -- **refused with
     * `ENOTSUP` where the kernel does not distribute, macOS included**, so a server that wants the
     * port either way listens again without it; `ipv6_only` binds a v6 address alone, so a v4 client
     * is not taken through the v4-mapped addresses, and is `EINVAL` with a v4 address.
     *
     *     val l = io.listen(ip4("0.0.0.0", 8080)?, reuse_port = true)?
     */
    listen(self, addr: libuv.Address, backlog: int = 128, reuse_port: bool = false,
           ipv6_only: bool = false) -> Result[&Listener, Error]
        var flags: u32 = 0

        if reuse_port then flags |= libuv.TCP_REUSEPORT
        if ipv6_only then flags |= libuv.TCP_IPV6ONLY

        listen_on(self.lp, addr, backlog, flags)

    /** A task that reads the whole of the file at `path`. */
    read_file(self, path: string) -> Task[Result[[]u8, Error]] = read_file_on(self.lp, path)

    /** A task that writes `bytes` as the whole of the file at `path`, creating or truncating it. */
    write_file(self, path: string, bytes: []const u8) -> Task[Result[unit, Error]] =
        write_file_on(self.lp, path, bytes)

    /** A task that appends `bytes` to the file at `path`, creating it if it is not there. */
    append_file(self, path: string, bytes: []const u8) -> Task[Result[unit, Error]] =
        append_file_on(self.lp, path, bytes)

    /** Watch `path` for changes, taken one at a time with `next`; `recursive` asks for its
     * subdirectories too, where the platform can. A path that is not there is `ENOENT`, from this call.
     */
    watch(self, path: string, recursive: bool = false) -> Result[&Watch, Error] =
        watch_on(self.lp, path, recursive)

    /** A task that resolves `host` and `service` on libuv's thread pool, ending with every way the
     * resolver found to reach it, in the order it prefers. `flags` takes libuv's `AI_` constants;
     * `AI_NUMERICHOST` answers `EAI_NONAME` for a name rather than asking the network.
     */
    resolve(self, host: string, service: string = "", flags: i32 = 0) -> Task[Result[[]libuv.AddrInfo, Error]] =
        resolve_on(self.lp, host, service, flags)

    /** Two connected streams, which is `socketpair(2)`: what is written to one is read from the
     * other.
     */
    socket_pair(self) -> Result[(&Pipe, &Pipe), Error] = socket_pair_on(self.lp)

    /** This process's standard input as a stream: a terminal if it is one, a pipe or a socket
     * otherwise. libuv owns the descriptor afterwards, and closing the stream closes it.
     */
    stdin(self) -> Result[&Pipe, Error] = adopt_on(self.lp, 0)

    /** Standard output, as `stdin` is opened. */
    stdout(self) -> Result[&Pipe, Error] = adopt_on(self.lp, 1)

    /** Standard error, as `stdin` is opened. */
    stderr(self) -> Result[&Pipe, Error] = adopt_on(self.lp, 2)

    /** A stream over a descriptor this process already has -- a pipe, a socket, a terminal. libuv
     * owns it afterwards.
     */
    adopt(self, fd: i32) -> Result[&Pipe, Error] = adopt_on(self.lp, fd)

    /** The ipc channel a parent gave this process at descriptor `fd` -- a `Channel` slot of its
     * `spawn` -- opened as one, so it carries handles as well as bytes. libuv owns the descriptor
     * afterwards. `EBADF` for a descriptor that is not open, and a terminal is refused with `EINVAL`.
     */
    channel(self, fd: i32) -> Result[&Pipe, Error] = channel_on(self.lp, fd)

    /** Start `file` -- looked up on `PATH` unless it holds a slash -- with `args`, which do not
     * include its own name. `env` of `[]` inherits this process's environment, and anything else
     * replaces it; `cwd` of `""` starts it here. `env_add` (`NAME=value` entries) is added on top of
     * whichever environment that gives, replacing a variable of the same name -- so `env_add` alone is
     * this process's environment plus those. A program that is not there is `ENOENT`, from this call.
     * `extra` says what the child's descriptors from 3 on are, in order.
     */
    spawn(self, file: string, args: []const string, env: []const string = [], cwd: string = "",
          stdin: Stdio = Inherit, stdout: Stdio = Inherit, stderr: Stdio = Inherit,
          env_add: []const string = [], extra: []const Stdio = []) -> Result[&Process, Error]
        // Kept alive across the call: the child's environment is a view of it.
        val merged = merged_env(env, env_add)

        spawn_on(self.lp, file, args, merged.view(), cwd, stdin, stdout, stderr, extra)

    /** A task that ends with `signum` at its next arrival, on a watcher of its own. */
    signal(self, signum: i32) -> Task[Result[i32, Error]] = signal_on(self.lp, signum, self.quiets)

    /** A watcher for every arrival of `signum`, taken one at a time with `next`. */
    signals(self, signum: i32) -> Result[&Signals, Error] = signals_on(self.lp, signum, self.quiets)

    /** A task that ends with what the file system knows about `path`, following links. */
    stat(self, path: string) -> Task[Result[libuv.Stat, Error]] = stat_on(self.lp, path)

    /** A task that ends with everything in the directory `path`, without `.` and `..`, in name order. */
    scandir(self, path: string) -> Task[Result[[]libuv.Dirent, Error]] = scandir_on(self.lp, path)

    /** A task that makes the directory `path`, and only its last component. */
    mkdir(self, path: string, mode: i32 = 511) -> Task[Result[unit, Error]] = mkdir_on(self.lp, path, mode)

    /** A task that removes the empty directory `path`; `ENOTEMPTY` if it is not empty. */
    rmdir(self, path: string) -> Task[Result[unit, Error]] = rmdir_on(self.lp, path)

    /** A task that removes the file `path`. */
    unlink(self, path: string) -> Task[Result[unit, Error]] = unlink_on(self.lp, path)

    /** A task that renames or moves `path` to `to`. */
    rename(self, path: string, to: string) -> Task[Result[unit, Error]] = rename_on(self.lp, path, to)

    /** A task that sets the permission bits of `path` to `mode`. */
    chmod(self, path: string, mode: i32) -> Task[Result[unit, Error]] = chmod_on(self.lp, path, mode)

    /** A task that opens `path` as a `File`, with libuv's `O_` flags and, for a file it creates,
     * `mode`.
     */
    open(self, path: string, flags: i32 = libuv.O_RDONLY, mode: i32 = 420) -> Task[Result[&File, Error]] =
        open_file_on(self.lp, path, flags, mode)

    /** A task that runs `job` on libuv's thread pool and ends with what it answered. Dropping the
     * task takes a job no thread has started off the queue.
     */
    work[T](self, job: &sync Fn() -> T) -> Task[Result[T, Error]] = work_on(self.lp, job)

    /** Close the handles the driver made on the libuv loop -- its timer, and the `uv_async` its
     * notifiers and remotes wake it through -- so a program can close a loop of its own afterwards
     * (`l.close()`), as an actor's thread does before it ends. The driver is not used again, and no
     * waker or remote of a kairos loop over it may be either.
     */
    close(*self)
        close_handle(self.timer)

        self.notify match
            Some(a) ->
                close_handle(a)
                self.notify = None
            None -> ()

        // The close callbacks run on libuv's next turn.
        self.lp.run(libuv.RUN_NOWAIT).expect("libuv ran")
    end close
end Uv

/** A driver over libuv's default loop, which is what a program with one loop wants. */
uv() -> &Uv = uv_on(libuv.default_loop())

/** A driver over `lp`, a libuv loop of the program's own. */
uv_on(lp: &libuv.Loop) -> &Uv =
    // uv_timer_init only records the handle on the loop; it has no failure to answer.
    Uv(lp, libuv.timer(lp).expect("a timer on an initialised loop"), monotonic(), None, Quiet(0))

/** How many tasks wait on a watcher of this driver's that is in the background. */
private[uv] struct Quiet
    n: usize

private const slice_ms: long = 1

impl Driver for Uv
    now(*self) -> Duration = monotonic() - self.origin

    idle_until(*self, deadline: Option[Duration])
        if signalled() then return

        deadline match
            Some(d) ->
                val left = d - self.now()

                if left <= millis(0)
                    self.poll()
                    return

                // libuv's timers count whole milliseconds from the loop's cached clock: refresh it,
                // and round up so the wait never ends before the deadline.
                self.lp.update_time()
                self.timer.start(u64((left.us + 999) / 1000), 0, nothing).expect("a stopped timer starts")
                self.lp.run(libuv.RUN_ONCE).expect("libuv ran")
                self.timer.stop().expect("a timer stops")
            None ->
                if self.lp.alive()
                    self.lp.run(libuv.RUN_ONCE).expect("libuv ran")
                else
                    self.notify match
                        // Counted for this wait alone, so libuv blocks until a waker sends.
                        Some(a) ->
                            a.keep()
                            self.lp.run(libuv.RUN_ONCE).expect("libuv ran")
                            a.unref()
                        None -> sleep(millis(slice_ms))
    end idle_until

    // The async is made on the first ask and kept unreferenced, so it holds the libuv loop open only
    // for a wait with nothing else in it. Its callback does nothing: ending libuv's wait is the whole
    // of its job, and the kairos loop looks at what was raised when the wait returns.
    override waker(*self) -> &sync Fn() -> unit
        val a = self.notify match
            Some(a) -> a
            None ->
                // uv_async_init fails only on a loop that cannot make its wake-up descriptor.
                val a = libuv.notifier(nothing, self.lp).expect("an async on an initialised loop")

                a.unref()
                self.notify = Some(a)
                a

        val w = a.waker()

        () -> w.send().unwrap_or(())
    end waker

    override quiet(*self) -> bool = self.quiets.n > 0

    override busy(*self) -> bool = self.lp.alive()

    override poll(*self)
        self.lp.run(libuv.RUN_NOWAIT).expect("libuv ran")

    override backend_fd(*self) -> Option[int]
        val fd = self.lp.backend_fd()

        if fd >= 0 then Some(int(fd)) else None

    // libuv answers 0 for a loop with nothing alive, which would have an embedder spin; with nothing
    // alive there is nothing of libuv's to wait for, so it sets no limit. Its timers count from the
    // cached clock, which is refreshed first so a stale one cannot stretch the wait.
    override backend_timeout(*self) -> Option[Duration]
        if !self.lp.alive() then return None

        self.lp.update_time()
        val ms = self.lp.backend_timeout()

        if ms < 0 then None else Some(millis(long(ms)))
    end backend_timeout
end Uv

private[uv] nothing() = ()

/** One operation's answer, and the waker of the task waiting for it.
 *
 * The libuv callback calls `finish`; the task's `park` calls `arm`. Whichever runs second is the one
 * that wakes the task, so an answer that arrives during the start is not lost.
 */
private[uv] struct Pending[T]
    result: Option[T]
    wake: Option[&Fn() -> unit]
    abandoned: bool

    finish(*self, v: T)
        self.result = Some(v)

        self.wake match
            Some(w) ->
                self.wake = None
                w()
            None -> ()

    arm(*self, w: &Fn() -> unit)
        if self.result.is_some() then w() else self.wake = Some(w)

    // Said by a `defer` on the way out: a callback still to come answers into nothing.
    abandon(*self)
        if self.result.is_none() then self.abandoned = true
end Pending

private[uv] pending[T]() -> &Pending[T] = Pending(None, None, false)

/** Park until `p` has its answer, and take it. */
private[uv] async settled[T](p: &Pending[T]) -> T
    await park((w) -> p.arm(w))

    p.result.expect("a park is woken only by its operation's answer")
#endif
