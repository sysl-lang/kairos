module sh.sysl.kairos.uv
#if feature_uv
@requires(posix)

// Byte streams: what a TCP connection, a pipe and a terminal share.
//
//     val (a, b) = io.socket_pair()?
//     (await a.write("ping".bytes))?
//     val got = (await b.read())?             // empty at the end of the stream
//
// **One implementation, every kind of stream.** The read, the write, the half-close and the close
// below are written once over libuv's `Stream` trait; `Connection` and `Pipe` are thin owners of a
// libuv handle and the one read that may be in flight on it.
//
// **libuv pushes and a task pulls.** A stream is read by starting libuv's reading, taking the first
// chunk that arrives, and stopping again inside the callback -- so nothing arrives that no `read`
// asked for, and a `read` that is dropped leaves the bytes in the kernel for the next one.

import sh.sysl.libuv
import sh.sysl.libuv.{Handle, Stream}
import sysl.slices.copy

/** What every byte stream here answers: a TCP `Connection`, and a `Pipe` -- a pipe, a Unix-domain
 * socket or a terminal. Code written over it runs on any of them, which is how a protocol layered on
 * a stream -- TLS, a framing, an echo -- is written once:
 *
 *     async echo[S: ByteStream](s: &S) -> Result[unit, Error]
 *         loop
 *             val got = (await s.read())?
 *             if got.len == 0 then break
 *             (await s.write(got))?
 *         (await s.shutdown())?
 *         Ok(())
 *
 * A write and a shutdown are issued when they are called, in the order they are called; the task
 * each answers only says how it ended.
 */
trait ByteStream
    /** A task that ends with the next bytes that arrived -- at most 64 KiB -- or with an empty slice
     * once the other end has closed its writing half. Dropping it before it ends consumes nothing.
     */
    read(self) -> Task[Result[[]u8, Error]]

    /** Queue `bytes` now, behind every write and shutdown issued before; the task ends when they have
     * been handed to the kernel. The bytes are copied, so the caller's slice need not outlive the
     * call, and dropping the task does not take the write back.
     */
    write(self, bytes: []const u8) -> Task[Result[unit, Error]]

    /** Close the writing half now, once every write queued before it has gone; the task ends when it
     * has. The other end reads the end of the stream, and may still answer.
     */
    shutdown(self) -> Task[Result[unit, Error]]

    /** Close the stream and the descriptor under it. A task still reading ends with `ECANCELED`, and
     * so does a write libuv still held -- one the kernel had not yet taken. Closing again does
     * nothing.
     */
    close(self)
end ByteStream

/** The read a stream has in flight, if any: where `close` finds the task to end with `ECANCELED`. */
private[uv] struct Reader
    reading: Option[&Pending[Result[[]u8, Error]]]

private[uv] reader() -> &Reader = Reader(None)

private[uv] async read_stream[S: Stream](s: &S, r: &Reader) -> Result[[]u8, Error]
    if s.is_closing() then return Err(cancelled())

    val p: &Pending[Result[[]u8, Error]] = pending()

    s.read_start((got) ->
        s.read_stop()
        p.finish(got match
            libuv.Data(bytes) -> Ok(copy_of(bytes))
            libuv.End -> Ok([0; 0])
            libuv.Failed(e) -> Err(e)))?

    r.reading = Some(p)
    defer stop_reading(s, r)

    await settled(p)
end read_stream

private[uv] stop_reading[S: Stream](s: &S, r: &Reader)
    r.reading = None
    if !s.is_closing() then s.read_stop()

// **A write and a shutdown are issued at the call, and the task only reports how they ended.** libuv
// queues them in the order they were issued, so `write(a)`, `write(b)`, `shutdown()` from one turn go
// out as `a`, `b`, then the end of the stream, whether or not -- and in whatever order -- their tasks
// are awaited, and a task dropped unawaited still has its bytes sent. A refusal at the call (the
// handle is closed) is the task's answer, not lost.
private[uv] write_stream[S: Stream](s: &S, bytes: []const u8) -> Task[Result[unit, Error]]
    val p: &Pending[Result[unit, Error]] = pending()

    s.write(bytes, (r) -> p.finish(r)) match
        Err(e) -> p.finish(Err(e))
        Ok(_) -> ()

    completion(p)

private[uv] shutdown_stream[S: Stream](s: &S) -> Task[Result[unit, Error]]
    val p: &Pending[Result[unit, Error]] = pending()

    s.shutdown((r) -> p.finish(r)) match
        Err(e) -> p.finish(Err(e))
        Ok(_) -> ()

    completion(p)

private[uv] async completion(p: &Pending[Result[unit, Error]]) -> Result[unit, Error]
    await settled(p)

// Every stream here closes through this, so closing twice -- or closing and then dropping -- is safe,
// and a task still reading ends with `ECANCELED` rather than waiting on a handle that is gone.
private[uv] close_stream[S: Stream](s: &S, r: &Reader)
    if !s.is_closing() then s.close()

    r.reading match
        Some(p) ->
            r.reading = None
            p.finish(Err(cancelled()))
        None -> ()

// What a task waiting on a handle that was closed under it ends with.
private[uv] cancelled() -> Error = libuv.Error(libuv.ECANCELED)

// libuv reads every chunk into the one buffer it reuses, so a chunk a task keeps is a copy -- made
// with one `memmove` rather than byte by byte.
private[uv] copy_of(bytes: []const u8) -> []u8
    var out: []u8 = [0; bytes.len]

    copy(out, bytes)
    out

// What a `Pipe` is over: a pipe or a socket of the Unix domain, or a terminal.
private enum End
    Piped(p: &libuv.Pipe)
    Terminal(t: &libuv.Tty)

/** One end of a pipe, of a Unix-domain socket, or a terminal: a child's standard streams, one of a
 * `socket_pair`, or this process's own `stdin`, `stdout` and `stderr`. Reached through `&Pipe`;
 * `close` ends it, and a pipe dropped without being closed is closed then.
 */
struct Pipe
    private end: End
    private reads: &Reader

    /** Whether this is a terminal, which is how `stdin` was opened when it is one. */
    is_terminal(self) -> bool = self.end match
        Piped(_) -> false
        Terminal(_) -> true

    /** Queue `bytes` now, with `h` beside them, for the other end to take with `read_handles`; the
     * task ends when they have been handed to the kernel. As with `write`, it is issued at the call,
     * in order with every write before it. **Only a channel can** -- a `Channel` slot of `spawn`,
     * or `io.channel(fd)` in the child -- and anything else is `EINVAL`, as is passing a terminal.
     * Empty `bytes` are `EINVAL` too: a handle travels attached to them, and the other end would
     * read none as the end of the stream.
     *
     * What crosses is a duplicate of the descriptor: **this side still has its own, and still closes
     * it -- but only once the other end has TAKEN it**, which a reply over the channel says. The task
     * ends when the descriptor is in the kernel's hands, not the other process's: until it is
     * received it is in flight, and an in-flight socket whose last open copy is closed can be
     * destroyed by the kernel's collector for descriptors in flight. macOS does this when another
     * process triggers a collection at the wrong moment, so a listener closed straight after
     * `write_handle` reaches the child dead often enough under load.
     */
    write_handle(self, bytes: []const u8, h: Passing) -> Task[Result[unit, Error]]
        val ch = self.channel_end()

        h match
            PassConnection(c) -> write_handle_on(ch, bytes, c.sock)
            PassListener(l) -> write_handle_on(ch, bytes, l.sock)
            PassPipe(p) -> p.end match
                Piped(it) -> write_handle_on(ch, bytes, it)
                Terminal(_) -> refused(libuv.Error(libuv.EINVAL))

    /** A task that ends with the next bytes that arrived, as `read` does, and every socket or pipe
     * the other end sent beside them -- taken as they arrived, since libuv keeps a pending handle only
     * that long. A pipe that is not a channel can be sent none, so it only ever answers bytes; a
     * terminal answers `EINVAL`.
     */
    read_handles(self) -> Task[Result[Message, Error]] = read_handles_on(self.channel_end(), self.reads)

    // The pipe under this end, which only a channel's is worth asking for: a terminal has none.
    private channel_end(self) -> Option[&libuv.Pipe] = self.end match
        Piped(p) -> Some(p)
        Terminal(_) -> None
end Pipe

// A stream is an opaque live resource, not the backend's handle storage. In particular,
// diagnostic formatting must not walk libuv's self references or its private handle enum.
impl Debug for Pipe
    debug(self, out: *Writer, fmt: FormatSpec)
        val kind = if self.is_terminal() then "Pipe(terminal)" else "Pipe(pipe)"
        kind.display(out, fmt)

// Reading, writing, the half-close and the close are `ByteStream`'s, so code over the trait takes a
// pipe as readily as a connection.
impl ByteStream for Pipe
    read(self) -> Task[Result[[]u8, Error]] = self.end match
        Piped(p) -> read_stream(p, self.reads)
        Terminal(t) -> read_stream(t, self.reads)

    write(self, bytes: []const u8) -> Task[Result[unit, Error]] = self.end match
        Piped(p) -> write_stream(p, bytes)
        Terminal(t) -> write_stream(t, bytes)

    shutdown(self) -> Task[Result[unit, Error]] = self.end match
        Piped(p) -> shutdown_stream(p)
        Terminal(t) -> shutdown_stream(t)

    close(self) = self.end match
        Piped(p) -> close_stream(p, self.reads)
        Terminal(t) -> close_stream(t, self.reads)
end Pipe

impl Drop for Pipe
    drop(self) = self.close()

private[uv] piped(p: &libuv.Pipe) -> &Pipe = Pipe(Piped(p), reader())

/** Two connected streams, which is `socketpair(2)`: what is written to one is read from the other. */
private[uv] socket_pair_on(lp: &libuv.Loop) -> Result[(&Pipe, &Pipe), Error]
    val (a, b) = libuv.socket_pair()?

    // Both are adopted before either can fail, so a descriptor that could not be is closed with the
    // other's stream rather than left open.
    val first = adopt_on(lp, a)
    val second = adopt_on(lp, b)

    Ok((first?, second?))

/** A stream over a descriptor this process already has. A terminal is opened as one, and anything
 * else -- a pipe, a socket -- as a pipe. **libuv owns the descriptor afterwards**, and closing the
 * stream closes it.
 */
private[uv] adopt_on(lp: &libuv.Loop, fd: i32) -> Result[&Pipe, Error]
    if libuv.guess_handle(fd) == libuv.HANDLE_TTY
        return Ok(Pipe(Terminal(libuv.tty(fd, lp)?), reader()))

    val p = libuv.pipe(false, lp)?

    p.open(fd) match
        Err(e) ->
            p.close()
            return Err(e)
        Ok(_) -> ()

    Ok(piped(p))
end adopt_on
#endif
