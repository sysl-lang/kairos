module sh.sysl.kairos

import sysl.sync.Atomic
import sysl.buf.{Buf, buf}
import sysl.container.{Heap, heap}
import sysl.time.{Duration, micros}

/** An event loop for a machine with interrupts and nothing else: numbered sources an interrupt
 * raises, timers on one clock, and closures that run on every pass.
 *
 * **Two halves, and only one of them may run in an interrupt.** `signal` is the whole of the
 * interrupt half: one atomic OR into a word of module storage, no allocation, no closure, nothing
 * that can block. Everything else -- the handlers, the timers, the handles -- lives on a `Loop` the
 * program builds in `main`, and runs on the loop's own stack when `run` drains what the interrupts
 * left behind.
 */

/** How many sources there are: one per bit of the pending word. */
const max_sources: u32 = 32

/** The interrupt half's whole state. Zero at reset, so it lands in `.bss` and needs no constructor --
 * which is what lets an interrupt fire before `main` has built anything without reading garbage.
 */
private var pending: Atomic[u32] = Atomic(0)

/** Raise source `n`: the one thing an interrupt handler calls.
 *
 * It sets one bit and returns. Raising a source twice before the loop gets to it is raising it once,
 * because a source is a bit and not a queue -- a handler drains whatever its hardware has buffered,
 * not one item per call. A number outside `0..<max_sources` is ignored rather than refused, because
 * an interrupt has nobody to refuse it to; `Loop.on` is where an out-of-range number is caught.
 */
signal(n: u32)
    if n < max_sources
        pending.or(1 << n)

/** Whether any source is raised and not yet drained.
 *
 * **This is what a `Driver.idle_until` checks before it sleeps**, with interrupts masked, so that a
 * signal landing between the loop's last look and the sleep instruction wakes it rather than waiting
 * for the next one. On a Cortex-M that is `cpsid i`, this, `wfi`, `cpsie i`: WFI wakes on a pending
 * interrupt even while interrupts are masked.
 */
signalled() -> bool = pending.load() != 0

/** The machine the loop runs on: where its time comes from and how it waits. A driver is a value the
 * program chooses in code -- `host()` for a laptop, `sim()` for a test, one for a board -- and the
 * loop is generic over it, so the choice costs nothing at run time.
 *
 * Time is a `Duration` from an origin the driver chooses -- boot, on a board -- and never goes
 * backwards.
 *
 * `idle_until` waits until the deadline or until something is signalled, whichever is first, and it
 * may return early for any reason at all: the loop looks at the clock again and carries on. `None`
 * means there is no timer, so only a signal can give the loop anything to do. A board implements it
 * as WFI with SysTick, or a one-shot timer compare, set for the deadline; it must return at once if
 * `signalled()` is already true.
 *
 * Two members have defaults, and only a driver that is itself a source of events overrides them --
 * the libuv one, whose sockets and files wake tasks from inside `idle_until`. `busy` says it holds
 * such work, which keeps the loop alive while a task waits on it. `poll` takes in whatever has already
 * happened without waiting, and is called on a pass that does not idle, so a task that only yields
 * cannot starve the driver's events.
 *
 * Two more are for a loop embedded in somebody else's -- a GUI toolkit's, a runtime's -- which waits
 * on its own and only calls `Loop.pass(NoWait)` when it wakes. `backend_fd` is the descriptor the
 * driver's events make readable, where there is one. `backend_timeout` is the longest the embedder may
 * wait on it before the driver has something of its own to do, and `None` where the driver sets no
 * limit. Neither counts the loop's own timers or tasks; `Loop.timeout` adds those.
 *
 * Two more are for other threads and quiet waits. `waker` answers the closure a `Notifier` or a
 * `Remote` calls, from any thread, after it has set its flag: it must end the driver's current
 * `idle_until`, or the next one if none is in progress, without allocating or blocking. The default
 * does nothing, which is right for a board whose `idle_until` is WFI, since any interrupt ends it;
 * a board with a second core overrides it with `sev`, and the libuv driver sends a `uv_async`. It is
 * asked for once per loop, the first time a notifier or remote is made. `quiet` says a task waits on
 * something of the driver's that does not keep the loop alive -- a background wait -- so `run` leaves
 * parked tasks parked when it ends rather than cancelling them.
 */
trait Driver
    now(*self) -> Duration
    idle_until(*self, deadline: Option[Duration])

    busy(*self) -> bool = false

    poll(*self) = ()

    backend_fd(*self) -> Option[int] = None

    backend_timeout(*self) -> Option[Duration] = None

    waker(*self) -> &sync Fn() -> unit = () -> ()

    quiet(*self) -> bool = false

/** How far one `Loop.pass` may wait for something to happen, as libuv's `uv_run` modes say it. */
enum PassMode
    /** Not at all: take in whatever the driver has ready, run what is due, and return. */
    NoWait

    /** Until the next timer, source, task or driver event, if nothing is ready already. */
    Once

    /** As `Once`, but no longer than `d`. */
    Until(d: Duration)

/** What other threads reach one loop through: the sources raised for it by a `Remote`, whether any
 * of its notifiers was woken, and the driver's wake. Every field is safe to touch from any thread.
 */
private struct Bell
    raised: Atomic[u32]
    rung: Atomic[u32]
    ring: &sync Fn() -> unit

/** One notifier's pending wake, set by its wakers and taken by its loop. */
private struct Flag
    set: Atomic[u32]

/** The loop's count of tasks parked on a notifier: `held` ones keep it alive and `quiet` ones do not,
 * but stop `run` cancelling what is parked when it ends.
 */
private struct Keeps
    held: usize
    quiet: usize

/** Wakes one notifier from any thread. It is a value: copy it to as many threads as wake it.
 *
 * **The loop has to outlive it**: a waker whose loop's driver is gone wakes something that is not
 * there, as a `uv_async_send` on a closed handle would. Its own flag and the loop's bell are boxes
 * the waker holds, so a waker that outlives only its `Notifier` is harmless: nothing takes the wake.
 */
struct Waker
    private flag: &sync Flag
    private bell: &sync Bell

    /** Wake the notifier, and end the loop's wait. Wakes before the loop gets to them are one wake.
     * Safe from any thread, and it neither allocates nor blocks.
     */
    wake(self)
        if self.flag.set.swap(1) == 0
            self.bell.rung.store(1)
            self.bell.ring()
end Waker

/** Raises a source of one loop from any thread, and ends that loop's wait so it sees it at once. It
 * is a value: copy it to as many threads as raise the source. The loop has to outlive it, as for a
 * `Waker`.
 */
struct Remote
    private source: u32
    private bell: &sync Bell

    /** Raise the source on its loop -- that loop only -- and end the loop's wait. */
    raise(self)
        self.bell.raised.or(1 << self.source)
        self.bell.ring()

    /** The source this raises. */
    number(self) -> u32 = self.source
end Remote

/** A wake another thread sends one loop: the cross-thread mailbox's doorbell. `lp.notifier()` makes
 * one; `waker()` answers the value a thread wakes it with; a task takes the wakes with `next`.
 *
 * **Wakes coalesce.** Any number of wakes before a `next` takes them are one, so the task's job is to
 * go and look at whatever the other threads left behind, not to count. A wake while no task waits is
 * kept, and the next `next` ends at once.
 *
 * **It keeps the loop alive only while a task waits in `next`**, and not even then once it is put in
 * the `background`: a task waiting on a background notifier is left parked, neither waited for nor
 * cancelled, when nothing else is left. `keep` undoes it, and either may be called while a task
 * waits.
 *
 * One task waits at a time.
 */
struct Notifier
    private flag: &sync Flag
    private bell: &sync Bell
    private keeps: &Keeps
    private waiter: Option[&Fn() -> unit]
    private woken: bool
    private waiting: bool
    private quiet: bool

    /** The value a thread wakes this notifier with. */
    waker(self) -> Waker = Waker(self.flag, self.bell)

    /** A task that ends at the next wake, or at once if one came since the last `next` ended. */
    next(&self) -> Task[unit] = notified(self)

    /** Stop counting a task waiting here as something that keeps the loop alive. */
    background(*self)
        if self.quiet then return

        self.quiet = true
        if self.waiting
            self.keeps.held -= 1
            self.keeps.quiet += 1
    end background

    /** Count a waiting task again, as a notifier does when it is made. */
    keep(*self)
        if !self.quiet then return

        self.quiet = false
        if self.waiting
            self.keeps.quiet -= 1
            self.keeps.held += 1
    end keep

    /** Whether it is in the background. */
    is_background(self) -> bool = self.quiet

    // The loop found the flag set.
    private[kairos] take(*self)
        self.woken = true

        self.waiter match
            Some(w) ->
                self.waiter = None
                w()
            None -> ()
    end take

    private[kairos] arm(*self, w: &Fn() -> unit)
        if self.woken then w() else self.waiter = Some(w)

    private[kairos] begin_wait(*self)
        if self.waiting then panic("a notifier is waited on by one task at a time")

        self.waiting = true
        if self.quiet then self.keeps.quiet += 1 else self.keeps.held += 1

    private[kairos] end_wait(*self)
        self.waiting = false
        self.waiter = None
        if self.quiet then self.keeps.quiet -= 1 else self.keeps.held -= 1

    private[kairos] consume(*self)
        self.woken = false

    private[kairos] has_wake(self) -> bool = self.woken

    // The loop's side of the wake: take the flag, and answer whether it was set.
    private[kairos] taken(self) -> bool = self.flag.set.swap(0) != 0
end Notifier

/** Why `Loop.on` refused a source. */
enum SourceError
    OutOfRange(n: u32)
    Taken(n: u32)

/** A timer, as `after` and `every` answer it: the thing `cancel` takes. */
struct Timer
    private slot: u32
    private gen: u32

/** An idle or check handle, as `idle` and `check` answer it: the thing `remove` takes. */
struct Handle
    private idle: bool
    private slot: u32
    private gen: u32

/** A table of entries addressed by slot and generation, so a stale `Timer` or `Handle` -- one already
 * fired, cancelled or removed -- finds nothing rather than whatever reused its slot.
 */
private struct Slot[T]
    gen: u32
    item: Option[T]

private struct Slots[T]
    entries: Buf[Slot[T]]
    free: Buf[u32]
    live: usize

    add(*self, item: T) -> (u32, u32)
        self.live += 1

        self.free.pop() match
            Some(i) ->
                val gen = self.entries[usize(i)].gen + 1
                self.entries[usize(i)] = Slot(gen, Some(item))
                (i, gen)
            None ->
                self.entries.push(Slot(0, Some(item)))
                (u32(self.entries.len() - 1), 0)
    end add

    get(self, i: u32, gen: u32) -> Option[T]
        if usize(i) >= self.entries.len() then return None

        val e = self.entries[usize(i)]
        if e.gen == gen then e.item else None

    remove(*self, i: u32, gen: u32) -> bool
        if self.get(i, gen).is_none() then return false

        self.entries[usize(i)] = Slot(gen, None)
        self.free.push(i)
        self.live -= 1
        true
    end remove
end Slots

private slots[T]() -> Slots[T] = Slots(buf(), buf(), 0)

/** A task handed to `spawn`, as `spawn` answers it: the thing `abort` takes. */
struct Job
    private slot: u32
    private gen: u32

/** Why `block_on` came back without its task's result. */
enum RunError
    /** Nothing left in the loop could ever wake the task -- no timer, source or handle -- so it was
     * cancelled, with every other task in the same state; `parked` counts them all. Where a task
     * waits in the background, the others are left parked instead, as `run` leaves them.
     */
    Stalled(parked: usize)

    /** `stop` was called before the task finished. The task was cancelled. */
    Stopped

impl Eq for RunError
    eq(self, rhs: RunError) -> bool = (self, rhs) match
        (Stalled(a), Stalled(b)) -> a == b
        (Stopped, Stopped) -> true
        _ -> false

impl Display for RunError
    display(self, out: *Writer, fmt: FormatSpec) = self match
        Stalled(n) -> display_str(s"$n task(s) parked with nothing left to wake them", out, fmt)
        Stopped -> display_str("the loop was stopped first", out, fmt)

/** What the loop calls back: a timer, an idle or check handle, a source's handler. It is handed the
 * loop it runs on, so it can set a timer or stop the loop without capturing it.
 */
type Callback[D: Driver] = &Fn(*Loop[D]) -> unit

/** A timer's state; its place in the deadline order is a `Due` in the queue. */
private struct TimerState[D: Driver]
    cb: Callback[D]
    period: Option[Duration]

/** The run queue: the tasks woken since they were last stepped, by slot and generation. It is a box
 * of its own because every waker holds it, and a waker holding the loop would close a cycle through
 * the task that holds the waker.
 */
private struct Ready
    woken: Buf[Job]

/** One entry of the deadline queue. Ordered by deadline, then by the order entries were queued, so
 * two timers due at the same moment fire in the order they were set.
 */
private struct Due
    at: Duration
    seq: u64
    slot: u32
    gen: u32

impl Eq for Due
    eq(self, rhs: Due) -> bool = self.at == rhs.at && self.seq == rhs.seq

impl Ord for Due
    lt(self, rhs: Due) -> bool = self.at < rhs.at || (self.at == rhs.at && self.seq < rhs.seq)

/** The loop. Build one in `main`, register what it should do, and `run` it.
 *
 * Everything the loop calls back is handed the loop, so a callback can add a timer or stop the loop
 * without capturing the loop it is registered on.
 *
 * Each pass of `run`, in order:
 *
 * 1. reads the driver's clock once; every timer set during the pass is set from that reading;
 * 2. fires the timers that were due at that reading, earliest first;
 * 3. runs the idle handles;
 * 4. drains the pending sources, and runs the handler of each raised one;
 * 5. steps each task woken so far, once, in the order it was woken;
 * 6. runs the check handles;
 * 7. returns if `stop` was called or nothing is left, and otherwise waits: not at all if an idle
 *    handle exists, a task is woken, a timer is already due or a source is raised; else
 *    `idle_until` the nearest timer, or `idle_until(None)` if there is none.
 *
 * **The loop is also the executor.** A task is a `Task[unit]` handed to `spawn`; it runs until it
 * parks, and the waker its park hands out puts it back on the run queue -- from a timer, a source's
 * handler, or another task. A task woken while the tasks are being stepped waits for the next pass,
 * so one that only yields cannot keep a pass from ending. A parked task does not by itself keep the
 * loop alive: once nothing is left that could wake it, it is cancelled.
 */
struct Loop[D: Driver]
    private driver: &D
    private handlers: [32]Option[Callback[D]]
    private registered: u32
    private timers: Slots[TimerState[D]]
    private queue: Heap[Due]
    private seq: u64
    private idles: Slots[Callback[D]]
    private checks: Slots[Callback[D]]
    private tasks: Slots[Task[unit]]
    private ready: &Ready
    private stepping: Buf[Job]
    private time: Duration
    private stopping: bool
    private bell: Option[&sync Bell]
    private notifiers: Buf[weak Notifier]
    private keeps: &Keeps

    /** The time this pass started, as the driver read it. */
    now(self) -> Duration = self.time

    /** Handle source `n` with `cb` on every pass where it was raised.
     *
     * A source has one handler: a second `on` for the same number is refused with `Taken`, and the
     * first one stays. `off` frees it.
     */
    on(*self, n: u32, cb: Callback[D]) -> Result[unit, SourceError]
        if n >= max_sources then return Err(OutOfRange(n))
        if (self.registered & (1 << n)) != 0 then return Err(Taken(n))

        self.handlers[usize(n)] = Some(cb)
        self.registered |= 1 << n
        Ok(())
    end on

    /** Stop handling source `n`. Answers whether it had a handler. */
    off(*self, n: u32) -> bool
        if n >= max_sources || (self.registered & (1 << n)) == 0 then return false

        self.handlers[usize(n)] = None
        self.registered &= ~(1 << n)
        true
    end off

    /** Call `cb` once, `delay` from the start of this pass. */
    after(*self, delay: Duration, cb: Callback[D]) -> Timer = self.schedule(delay, None, cb)

    /** Call `cb` every `period`, the first time `period` from the start of this pass.
     *
     * The deadlines are exact multiples of `period` from the first: a pass that runs late does not
     * push the next deadline back. A period of zero fires once a pass.
     */
    every(*self, period: Duration, cb: Callback[D]) -> Timer = self.schedule(period, Some(period), cb)

    /** Cancel a timer. Answers whether it was still pending; a one-shot that has fired, or a timer
     * already cancelled, answers false. A timer may cancel itself, or any other, from a callback.
     */
    cancel(*self, t: Timer) -> bool = self.timers.remove(t.slot, t.gen)

    /** Run `cb` on every pass, and never sleep while it exists: for work that must be polled as fast
     * as the machine allows.
     */
    idle(*self, cb: Callback[D]) -> Handle
        val (slot, gen) = self.idles.add(cb)
        Handle(true, slot, gen)

    /** Run `cb` on every pass, after the sources are drained, and sleep as usual: for a library that
     * must be polled after anything happens -- TinyUSB's `tud_task`, LVGL's timer handler.
     */
    check(*self, cb: Callback[D]) -> Handle
        val (slot, gen) = self.checks.add(cb)
        Handle(false, slot, gen)

    /** Remove an idle or check handle. Answers whether it was still there. */
    remove(*self, h: Handle) -> bool =
        if h.idle then self.idles.remove(h.slot, h.gen) else self.checks.remove(h.slot, h.gen)

    /** A notifier of this loop's own, which any thread wakes through its `waker()`. */
    notifier(*self) -> &Notifier
        val f: &sync Flag = Flag(Atomic(0))
        val n: &Notifier = Notifier(f, self.bell_of(), self.keeps, None, false, false, false)

        self.notifiers.push(n)
        n
    end notifier

    /** A handle another thread raises source `n` of this loop through -- this loop's, not the
     * process's -- ending the loop's wait at once. `OutOfRange` for a number `on` would refuse.
     */
    remote(*self, n: u32) -> Result[Remote, SourceError]
        if n >= max_sources then return Err(OutOfRange(n))

        Ok(Remote(n, self.bell_of()))

    /** Make `run` return at the end of the current pass. */
    stop(*self)
        self.stopping = true

    /** Whether anything is left that could ever run: a timer, a handle, a source registered or
     * raised, a notifier woken, a woken task, a task waiting on a notifier not in the background, or
     * work the driver holds.
     */
    alive(self) -> bool
        if self.registered != 0 || self.timers.live > 0 || self.keeps.held > 0 then return true
        if self.idles.live > 0 || self.checks.live > 0 || !self.ready.woken.is_empty() then return true
        if self.raised() then return true

        self.driver.busy()

    /** How many tasks are spawned and not yet finished or cancelled, parked or woken. */
    running(self) -> usize = self.tasks.live

    /** Hand `t` to the loop. It is first stepped on the next pass, in turn with the other tasks. */
    spawn(*self, t: Task[unit]) -> Job
        val (slot, gen) = self.tasks.add(t)
        val j = Job(slot, gen)

        self.ready.woken.push(j)
        j
    end spawn

    /** Cancel a spawned task by dropping it: its `defer`s run, and whatever it was waiting on lets
     * go of it. Answers whether it was still there; a task that has finished answers false. A task
     * may abort itself.
     */
    abort(*self, j: Job) -> bool = self.tasks.remove(j.slot, j.gen)

    /** Run passes until `stop` is called or nothing is left. A task still parked when nothing is left
     * that could wake it is cancelled -- unless a task waits in the background, on a notifier or on
     * the driver, since that wait may yet end: then every parked task is left parked, for a later
     * `run` or `pass`.
     */
    run(*self)
        self.drive(() -> false)

    /** Run passes until `t` has its result, with every spawned task taking its turn beside it, and
     * answer that result. It returns as soon as `t` has finished, leaving the rest where they are.
     */
    block_on[T](*self, t: Task[T]) -> Result[T, RunError]
        val out: &Outcome[T] = outcome()
        val j = self.spawn(fill(t, out))
        val parked = self.drive(() -> out.value.is_some())

        out.value match
            Some(v) -> Ok(v)
            None ->
                // Already cancelled where nothing waits in the background; dropped here where
                // something does, and the rest stay parked.
                self.abort(j)

                if parked > 0 then Err(Stalled(parked)) else Err(Stopped)
    end block_on

    /** A task that ends `d` after the pass that first steps it. Dropped early, it cancels its timer. */
    sleep(&self, d: Duration) -> Task[unit] = sleep_on(self, d)

    /** A task that ends the next time source `n` is raised. It holds the source's one handler while
     * it waits, so it is refused with `Taken` where something else already handles `n`, and frees
     * the source when it ends or is dropped.
     */
    wait_for(&self, n: u32) -> Task[Result[unit, SourceError]] = wait_on(self, n)

    /** A task that runs `t` and ends with `Some` of its result, or with `None` if `d` passes first, in
     * which case `t` is dropped, which cancels it. A `t` that finishes in the pass its deadline falls
     * due still wins.
     */
    timeout[T](&self, d: Duration, t: Task[T]) -> Task[Option[T]] = timeout_on(self, d, t)

    /** One pass, for a program that drives the loop itself -- from inside another loop, or a `while`
     * of its own -- and answer whether anything is left that could ever run, as `alive` says it.
     *
     * It first waits as `mode` allows, but never while a task is woken, an idle handle exists, a
     * source is raised or a timer is due, and never when nothing is alive; then it runs the pass:
     * due timers, idle handles, raised sources, woken tasks, check handles. Whatever the wait took in
     * -- a socket's bytes, a timer falling due -- is handled in the same pass. Last, while the driver
     * is busy, it is polled once more without waiting: that takes in what arrived during the pass and
     * hands the driver what the pass started -- a read begun, a socket opened -- so the descriptor an
     * embedder waits on is watching it before the embedder sleeps on it.
     *
     * **It never cancels.** A task parked on something nothing will raise stays parked: a later
     * `spawn`, `signal` or `on` may yet wake it, which is the embedder's to know and not the loop's.
     * `run` and `block_on` are the ones that give up on it.
     *
     * A `stop` called during the pass is answered with false, and taken back, so `while
     * lp.pass(Once)` ends on it as `run` does.
     */
    pass(*self, mode: PassMode) -> bool
        self.stopping = false

        if self.alive()
            self.time = self.driver.now()

            mode match
                NoWait -> self.driver.poll()
                Once -> self.wait(None)
                Until(d) -> self.wait(Some(self.time + d))

        self.turn()

        if self.driver.busy() then self.driver.poll()

        val stopped = self.stopping
        self.stopping = false

        !stopped && self.alive()
    end pass

    /** How long an embedder may wait before the next `pass(NoWait)` has something to do: zero while
     * a task is woken, an idle handle exists or a source is raised; otherwise the nearer of the next
     * timer and the driver's `backend_timeout`; `None` when neither sets a limit, so only an event
     * on `backend_fd` -- or a `spawn` or `signal` from the embedder itself -- gives the loop work.
     */
    timeout(*self) -> Option[Duration]
        if self.idles.live > 0 || !self.ready.woken.is_empty() || self.raised() then return Some(micros(0))

        val mine = self.next_deadline() match
            Some(d) ->
                val now = self.driver.now()
                Some(if d > now then d - now else micros(0))
            None -> None

        (mine, self.driver.backend_timeout()) match
            (Some(a), Some(b)) -> Some(if a < b then a else b)
            (Some(a), None) -> Some(a)
            (None, b) -> b
    end timeout

    /** The descriptor an embedder polls for the driver's events, as the driver's `backend_fd` gives
     * it: libuv's epoll or kqueue descriptor on the `uv` driver, `None` on one that has no such thing.
     */
    backend_fd(*self) -> Option[int] = self.driver.backend_fd()

    // Passes until `done` says so, `stop` is called, or nothing is left; answers how many tasks were
    // left parked because nothing was left that could wake them -- cancelled, unless a background
    // wait may yet wake one.
    private drive(*self, done: &Fn() -> bool) -> usize
        self.stopping = false

        while self.alive()
            self.turn()

            if self.stopping || done() || !self.alive() then break

            self.wait(None)

        self.stopping = false

        if self.alive() || done() then return 0
        if self.keeps.quiet > 0 || self.driver.quiet() then return self.tasks.live

        self.cancel_parked()
    end drive

    // The body of a pass, from reading the clock to the check handles.
    private turn(*self)
        self.time = self.driver.now()
        self.fire_timers()
        self.run_handles(true)
        self.drain()
        self.step_ready()
        self.run_handles(false)

    // Step each task woken before this point once. Wakers called while stepping push onto the other
    // buffer, which the next pass steps.
    private step_ready(*self)
        val woken = self.ready.woken

        self.ready.woken = self.stepping
        self.stepping = woken

        for k in 0..<woken.len()
            val j = woken[k]

            self.tasks.get(j.slot, j.gen) match
                Some(t) ->
                    val q = self.ready

                    if step(t, () -> q.woken.push(j)) then self.tasks.remove(j.slot, j.gen)
                None -> ()

        self.stepping.clear()
    end step_ready

    private cancel_parked(*self) -> usize
        val n = self.tasks.live

        for i in 0..<self.tasks.entries.len()
            val e = self.tasks.entries[i]
            if e.item.is_some() then self.tasks.remove(u32(i), e.gen)

        n
    end cancel_parked

    private schedule(*self, delay: Duration, period: Option[Duration], cb: Callback[D]) -> Timer
        val (slot, gen) = self.timers.add(TimerState(cb, period))
        self.enqueue(self.time + delay, slot, gen)
        Timer(slot, gen)

    private enqueue(*self, at: Duration, slot: u32, gen: u32)
        self.queue.push(Due(at, self.seq, slot, gen))
        self.seq += 1

    /** Fire what was due at this pass's reading. A timer set during the pass waits for the next one,
     * even at a delay of zero, so a callback that sets one cannot keep a pass from ending.
     */
    private fire_timers(*self)
        val mark = self.seq

        loop
            val due = self.queue.peek() match
                Some(d) -> d
                None -> return

            if due.at > self.time || due.seq >= mark then return

            self.queue.pop()

            self.timers.get(due.slot, due.gen) match
                Some(t) ->
                    t.period match
                        Some(p) -> self.enqueue(due.at + p, due.slot, due.gen)
                        None -> self.timers.remove(due.slot, due.gen)

                    t.cb(self)
                None -> ()
    end fire_timers

    /** The nearest live deadline, dropping cancelled entries off the front of the queue on the way. */
    private next_deadline(*self) -> Option[Duration]
        loop
            val due = self.queue.peek() match
                Some(d) -> d
                None -> return None

            if self.timers.get(due.slot, due.gen).is_some() then return Some(due.at)

            self.queue.pop()
    end next_deadline

    private run_handles(*self, idle: bool)
        val n = if idle then self.idles.entries.len() else self.checks.entries.len()

        for i in 0..<n
            val e = if idle then self.idles.entries[i] else self.checks.entries[i]

            e.item match
                Some(cb) -> cb(self)
                None -> ()
    end run_handles

    // The sources raised by an interrupt or a remote, then the notifiers woken from other threads.
    private drain(*self)
        var raised = pending.swap(0)

        self.bell match
            Some(b) ->
                raised |= b.raised.swap(0)
                if b.rung.swap(0) != 0 then self.take_wakes()
            None -> ()

        for n in 0..<max_sources
            if (raised & (1 << n)) != 0
                self.handlers[usize(n)] match
                    Some(cb) -> cb(self)
                    None -> ()
    end drain

    // Hand each woken notifier its wake, and forget the ones nothing holds any more.
    private take_wakes(*self)
        var i: usize = 0

        while i < self.notifiers.len()
            self.notifiers[i].get() match
                Some(n) ->
                    if n.taken() then n.take()
                    i += 1
                None -> self.notifiers.remove(i)
    end take_wakes

    // Whether a source is raised, by an interrupt or a remote, or a notifier woken, and not yet
    // drained.
    private raised(self) -> bool
        if signalled() then return true

        self.bell match
            Some(b) -> b.raised.load() != 0 || b.rung.load() != 0
            None -> false

    // The bell other threads ring this loop with, made the first time one is asked for.
    private bell_of(*self) -> &sync Bell
        self.bell match
            Some(b) -> b
            None ->
                val b: &sync Bell = Bell(Atomic(0), Atomic(0), self.driver.waker())

                self.bell = Some(b)
                b
    end bell_of

    // Wait for the nearest timer or the next event, but no later than `cap` where there is one.
    private wait(*self, cap: Option[Duration])
        if self.idles.live > 0 || !self.ready.woken.is_empty() || self.raised()
            self.driver.poll()
            return

        val deadline = (self.next_deadline(), cap) match
            (Some(a), Some(b)) -> Some(if a < b then a else b)
            (Some(a), None) -> Some(a)
            (None, b) -> b

        deadline match
            Some(d) -> if d > self.driver.now() then self.driver.idle_until(deadline) else self.driver.poll()
            None -> self.driver.idle_until(None)
    end wait
end Loop

/** A loop over `driver`, with nothing registered. It is a `&Loop` because a task reaches the loop it
 * runs on through the box -- `await lp.sleep(…)` -- for as long as it runs.
 */
event_loop[D: Driver](driver: &D) -> &Loop[D] =
    Loop(driver, [None; 32], 0, slots(), heap(), 0, slots(), slots(), slots(), Ready(buf()), buf(),
        driver.now(), false, None, buf(), Keeps(0, 0))
